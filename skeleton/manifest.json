  "bundles": {
    "_comment": "Opt-in bundles. sdlc-initialize prompts CD during setup; a bundle's files are installed only if the bundle is accepted. sdlc-migrate preserves existing installs and offers newly debuted bundles once, without removing files the project already has. Each bundle lists 'skills' (installed to .claude/skills/) and may list 'process' (docs installed to [sdlc-root]/process/) and 'fragments' (map of fragment source file -> target framework file, injected inside upstream-owned BUNDLE-SECTION markers per process/project-section-markers.md and refreshed from source on every migration — never preserved verbatim). Installer ordering: copy files, inject fragments, record in .sdlc-manifest.json installed_bundles/bundle_fragments last. A bundle may also carry files outside .claude/ and [sdlc-root]/ (since contract 0019): 'tree' ({from, to}: every file under the z-sdlc directory 'from' is installed at the same relative path under the project directory 'to', executable bits kept, hashed in installed_files and refreshed from source on every migration, like source_files), 'seed' ({from, to}: each file is written only where the target is absent, then belongs to the project, never overwritten, hashed or removed), 'render' (a command run from the project root after the files are in place, on install and on every migration) and 'requires' ({sdlc_root}: refuse the install when .sdlc-manifest.json's sdlc_root differs). Installer ordering for these: check requires, copy tree, write absent seeds, run render, then record the bundle.",
    "design": {
      "description": "UI/UX design consultation.",
      "skills": [
        "skills/sdlc-design-consult/SKILL.md"
      ]
    },
    "github-provenance": {
      "description": "GitHub provenance: every tracked deliverable narrated into a GitHub issue via lifecycle checkpoints, with optional Projects v2 board tracking and audit reconciliation. Inert until configured via the policy doc's Enablement section.",
      "skills": [
        "skills/sdlc-manage-github/SKILL.md"
      ],
      "process": [
        "process/github-checkpoints.md"
      ],
      "fragments": {
        "bundles/github-provenance/fragments/sdlc-plan.md": "skills/sdlc-plan/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-lite-plan.md": "skills/sdlc-lite-plan/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-execute.md": "skills/sdlc-execute/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-lite-execute.md": "skills/sdlc-lite-execute/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-handoff.md": "skills/sdlc-handoff/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-archive.md": "skills/sdlc-archive/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-audit.md": "skills/sdlc-audit/SKILL.md",
        "bundles/github-provenance/fragments/sdlc-compliance-auditor.md": "agents/sdlc-compliance-auditor.md"
      }
    },
    "factory": {
      "description": "Software factory: issue-driven agent stages (triage, implement, plan and spec, revise, execute with production gates, the weekly improve loop) on self-hosted runners, as GitHub Actions workflows rendered from the project's .github/factory/factory.json. Inert until configured via the process doc's Enablement section.",
      "skills": [
        "skills/sdlc-triage/SKILL.md",
        "skills/sdlc-implement/SKILL.md",
        "skills/sdlc-revise/SKILL.md"
      ],
      "process": [
        "process/factory.md"
      ],
      "tree": {
        "from": "bundles/factory/tree",
        "to": ".github/factory"
      },
      "seed": {
        "from": "bundles/factory/seed",
        "to": ".github/factory"
      },
      "render": "python3 .github/factory/render.py",
      "requires": {
        "sdlc_root": "ops/sdlc"
      }
    }
  }
