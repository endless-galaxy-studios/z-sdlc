#!/usr/bin/env bash
# Run a command with the browser host's Playwright server reachable from inside the Bash sandbox (D6).
# Usage: with-browser [--film] <command> [args...]
#        with-browser --ship-proof
#
# --film runs the filmed pass (D6 rule 7): the stage's last run of a spec, at a person's pace, which the project's
# evidence helper films with evidence_film.mjs (installed beside this file). It sets FACTORY_EVIDENCE_PACE=1 when the
# stage records video; the proof runs before it use no flag.
#
# The helper empties .factory/evidence/ when each run starts, so before a filmed pass starts this keeps the proof's
# folder as .factory/proof-evidence/, unless it already keeps one: a filmed pass run again keeps the proof's, not the
# earlier film's. A run without --film is a proof, and drops what's kept: a new proof replaces it. Nothing is kept or
# dropped when the front end doesn't answer, since the command never runs. --ship-proof puts the kept folder back as
# .factory/evidence/, so the proof's evidence ships instead of the film's (when the filmed pass didn't run cleanly, or
# the bug shows only in the proof). It needs no browser host. Run nothing else through with-browser between the filmed
# pass and it: that run drops the copy even when it writes no evidence. With nothing kept, it changes nothing and exits
# 1, since it can't tell whose files the folder holds: run the proof again, and its files are the ones that ship.
# Both work from the repository's top folder (the nearest folder above that holds .factory/, outside git), wherever
# the command runs.
#
# The browsers run on the browser host, never here. The command's Playwright client connects to the host's
# front end for the project's Playwright version, and the front end makes every browser send all its traffic
# back through that connection (exposeNetwork), so the browser loads the app this command starts on the
# sandbox's own loopback, and nothing else. The sandbox has no network but its HTTP proxy, which allows the
# front end's one address and port (browser.py added it to the stage's sandbox settings), so this forwards a
# loopback port to it through the proxy (CONNECT), as with-test-services does for the test services, and points
# Playwright Test at it (PW_TEST_CONNECT_WS_ENDPOINT). A script of the agent's own can connect to
# $FACTORY_BROWSER_WS_ENDPOINT with chromium.connect(), loading Playwright from $FACTORY_BROWSER_CLIENT, unless
# the project opens its browser contexts through a helper of its own: then it uses that helper, whose routes (an
# allowed host's context.route, D6 rule 6) a bare connect() would skip.
#
# Composes with with-test-services: `with-test-services with-browser npx playwright test ...`.
# When the route is missing or the browser host doesn't answer, it prints `UNAVAILABLE: browser host (<why>)`
# and exits 75: a run that gets it reports `blocked`, never that a bug was reproduced or ruled out.
# Installed read-only at /opt/factory by the job, with browser.conf (written by browser.py) beside it.
set -euo pipefail

conf=${FACTORY_BROWSER_CONF:-/opt/factory/browser.conf}
unavailable() { printf 'UNAVAILABLE: browser host (%s)\n' "$1" >&2; exit 75; }
usage() { echo "usage: with-browser [--film] <command> [args...] | with-browser --ship-proof" >&2; exit 2; }
top() {
  git rev-parse --show-toplevel 2> /dev/null && return
  local d=$PWD
  while [ "$d" != / ]; do
    if [ -d "$d/.factory" ]; then echo "$d"; return; fi
    d=$(dirname "$d")
  done
  pwd
}
root=$(top)
evidence=$root/.factory/evidence kept=$root/.factory/proof-evidence
if [ "${1:-}" = --ship-proof ]; then
  [ $# -eq 1 ] || usage
  if [ -d "$kept" ] && [ ! -L "$kept" ]; then
    rm -rf "$evidence"
    mv "$kept" "$evidence"
    echo "with-browser: the proof's evidence is back in .factory/evidence/ and ships; the filmed pass's is gone"
    exit 0
  fi
  echo "with-browser: nothing is kept in .factory/proof-evidence/, so nothing changed: .factory/evidence/ holds the last run's files, the proof's only if no filmed pass started since it. To ship the proof's, run the proof again." >&2
  exit 1
fi
film=0
if [ "${1:-}" = --film ]; then film=1; shift; fi
[ $# -gt 0 ] || usage
[ -r "$conf" ] || unavailable "this stage has no browser route: factory.json's browser block doesn't list it"
host= port= port_base= version= client= allow= probe= video=
while IFS='=' read -r k v; do
  case $k in
    host) host=$v ;; port) port=$v ;; port_base) port_base=$v ;; version) version=$v ;; client) client=$v ;;
    allow) allow=$v ;; probe) probe=$v ;; video) video=$v ;;
  esac
done < "$conf"
[[ $host =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ && $port =~ ^[0-9]{2,5}$ ]] || unavailable "$conf is malformed"

proxy=${HTTP_PROXY:-${http_proxy:-}}
if [ -n "$proxy" ]; then
  # http://[user:token@]host:port: the sandbox's proxy takes a per-session credential.
  hostport=${proxy#*://}
  hostport=${hostport%%/*}
  auth=
  if [[ $hostport == *@* ]]; then auth=${hostport%@*}; hostport=${hostport##*@}; fi
  phost=${hostport%:*}
  pport=${hostport##*:}
  # The same port on the sandbox's own loopback: each sandboxed command has a loopback of its own.
  socat "TCP-LISTEN:$port,bind=127.0.0.1,fork,reuseaddr" \
    "PROXY:$phost:$host:$port,proxyport=$pport${auth:+,proxyauth=$auth}" > /dev/null 2>&1 &
  for _ in $(seq 50); do (exec 3<> "/dev/tcp/127.0.0.1/$port") 2> /dev/null && break; sleep 0.1; done
  local_host=127.0.0.1
else
  # Outside the sandbox (no proxy set), the front end is reached directly.
  local_host=$host
fi

# The front end answers a plain request with 404; nothing at all means the host, or this version's front end,
# is down. (A busy host answers the WebSocket later, from its queue: Playwright waits for that.)
code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' --noproxy '*' "http://$local_host:$port/" || true)
if [ "$code" != 404 ]; then
  why="no answer from the front end for Playwright $version at $host:$port"
  if [ -n "$proxy" ]; then
    # Ask the proxy directly: a refusal is the sandbox's settings, not the host.
    # --noproxy '': the sandbox's NO_PROXY names the private ranges, and curl would skip even an explicit proxy for them.
    connect=$(curl -s -o /dev/null -m 10 -w '%{http_connect}' --noproxy '' --proxytunnel -x "$proxy" "http://$host:$port/" || true)
    case $connect in
      403) why="the sandbox's proxy refuses $host:$port: the stage's allowedDomains doesn't name it" ;;
      200) why="$why: the proxy connected, but nothing answered" ;;
    esac
  fi
  unavailable "$why (got '${code:-nothing}')"
fi

export FACTORY_BROWSER_WS_ENDPOINT="ws://$local_host:$port/"
# Where the project's Playwright client is installed, for a script that loads it (createRequire from there), and the
# front end's own address and port (factory-smoke's probe checks the sandbox refuses the host's other ports).
export FACTORY_BROWSER_CLIENT=$client FACTORY_BROWSER_HOST=$host FACTORY_BROWSER_PORT=$port
export FACTORY_BROWSER_PORT_BASE=${port_base:-3100}
export PW_TEST_CONNECT_WS_ENDPOINT=$FACTORY_BROWSER_WS_ENDPOINT
# The front end forces "*" whatever the client asks; asking for it too keeps a client-side check honest.
export PW_TEST_CONNECT_EXPOSE_NETWORK='*'
# The outside hosts CD allowed for this project (factory.json browser.allow), space-separated. The browser can't fetch
# them itself: Playwright's tunnel connects from the client directly, and the sandbox has no network but its proxy.
# A spec serves their requests with context.route(), fetching each through the proxy with Node's fetch, which
# NODE_USE_ENV_PROXY makes use the sandbox's HTTPS_PROXY.
export FACTORY_BROWSER_ALLOW=$allow
# The first allowed host's probe path (browser.allow's probe), which factory-smoke's probe fetches; empty for none.
export FACTORY_BROWSER_PROBE=$probe
# Whether this stage's reproducing and verifying runs record video (D6 rules 5 and 7): 1 for the stages, 0 for
# smoke. The project's evidence helper, or a spec, turns on plain recordVideo when it's 1.
export FACTORY_EVIDENCE_VIDEO=$([ "$video" = 1 ] && echo 1 || echo 0)
# The filmed pass: the module the project's evidence helper loads, and whether this run is that pass (--film, in a
# stage that records video). Without the flag the run is a proof, which nothing paces or draws on.
export FACTORY_EVIDENCE_FILM="$(cd "$(dirname "$0")" && pwd)/evidence_film.mjs"
export FACTORY_EVIDENCE_PACE=$([ "$film" = 1 ] && [ "$FACTORY_EVIDENCE_VIDEO" = 1 ] && echo 1 || echo 0)
if [ "$FACTORY_EVIDENCE_PACE" = 1 ]; then
  # The filmed pass: keep the proof's folder (an empty one when the proof left none, so --ship-proof ships nothing).
  if [ ! -e "$kept" ] && [ ! -L "$kept" ]; then
    rm -rf "$kept.partial"
    if [ -d "$evidence" ] && [ ! -L "$evidence" ]; then cp -a "$evidence" "$kept.partial"; else mkdir -p "$kept.partial"; fi
    mv "$kept.partial" "$kept"
    echo "with-browser: the proof's evidence is kept in .factory/proof-evidence/ (with-browser --ship-proof ships it instead)" >&2
  fi
else
  # A proof: what it writes replaces whatever an earlier proof left.
  rm -rf "$kept" 2> /dev/null || echo "with-browser: couldn't drop .factory/proof-evidence/: don't --ship-proof after this run" >&2
fi
if [ -n "$allow" ]; then export NODE_USE_ENV_PROXY=1; fi
exec "$@"
