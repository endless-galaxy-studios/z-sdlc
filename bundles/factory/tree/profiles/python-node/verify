#!/usr/bin/env bash
# python-node profile: the project's checks, for agents in the Bash sandbox. The factory's skills run
# this instead of naming the project's commands (they are `make verify`'s direct equivalents; make
# needs docker compose, which agent jobs don't have). Installed read-only at /opt/factory by
# agent_job.sh workspace, beside verify.conf (python=<dir>, node=<dir>, from factory.json's stack).
# Usage: verify [--print] [python|node|probe ...]
#   no area      python and node
#   python       the test suite, through with-test-services (it reaches the test database and Redis).
#                PYTHONSAFEPATH=1 keeps python -m from putting the project's directory first on sys.path,
#                where a module named like pytest or anything it imports would replace it; CI's pytest
#                script doesn't put it there either. A project's own pythonpath setting still applies.
#   node         lint, type check and production build, with the config files recorded before the agent
#                started
#   probe        what an agent job needs works here: the test database through the project's own
#                settings, and the Node toolchain (factory-smoke's implement-tools probe); prints
#                probe-ok when both do
#   --print      print the commands and run nothing (to run a narrower one, such as a single test)
# Runs every area asked for, even after one fails, and exits 1 if any did.
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
python_dir=$(sed -n 's/^python=//p' "$here/verify.conf")
node_dir=$(sed -n 's/^node=//p' "$here/verify.conf")
[ -n "$python_dir" ] && [ -n "$node_dir" ] || { echo "verify: no python or node directory in $here/verify.conf" >&2; exit 2; }
wrap=$here/with-test-services

# The config file each Node tool loads, recorded in verify.conf before the agent started (node_configs.py):
# passed to the tool, and checked first, so a config file added since fails the node area instead of
# quietly replacing the project's (CI's run would load it). ESLint is pinned only from the node directory:
# given --config, it reads the config's paths from the working directory rather than the config's own.
pin() {
  local v
  grep -q "^$1=" "$here/verify.conf" || { echo "verify: no $1= line in $here/verify.conf: agent_job.sh workspace records it" >&2; exit 2; }
  v=$(sed -n "s/^$1=//p" "$here/verify.conf")
  [[ -z $v || $v =~ ^(\.\./)*[A-Za-z0-9._-]+$ ]] || { echo "verify: $1= in $here/verify.conf names no config file: $v" >&2; exit 2; }
  [[ $1 == eslint_config && $v == ../* ]] && v=
  flag=${v:+ --config $v}
}
pin eslint_config; eslint=$flag
pin vite_config; vite=$flag
configs="/usr/local/bin/python3 -I $here/node_configs.py check $node_dir $here/verify.conf eslint vite"

print=no
areas=()
for a in "$@"; do
  case "$a" in
    --print) print=yes ;;
    python|node|probe) areas+=("$a") ;;
    *) echo "verify: unknown area $a (python, node, probe)" >&2; exit 2 ;;
  esac
done
[ ${#areas[@]} -gt 0 ] || areas=(python node)

command_for() {
  case "$1" in
    python) echo "$wrap bash -c 'cd $python_dir && PYTHONSAFEPATH=1 python -m pytest -q'" ;;
    node) echo "$configs && cd $node_dir && npx --no-install eslint .$eslint && npx --no-install tsc -b && npx --no-install vite build$vite" ;;
    probe) echo "$wrap bash -c 'cd $python_dir && python manage.py migrate --plan > /dev/null && echo db-ok' && (cd $node_dir && npx --no-install tsc --version) && echo probe-ok" ;;
  esac
}

failed=()
for area in "${areas[@]}"; do
  cmd=$(command_for "$area")
  if [ "$print" = yes ]; then echo "$area: $cmd"; continue; fi
  echo "== verify $area: $cmd"
  bash -c "$cmd" || failed+=("$area")
done
if [ ${#failed[@]} -gt 0 ]; then
  echo "verify: failed: ${failed[*]}"
  exit 1
fi
[ "$print" = yes ] || echo "verify: passed: ${areas[*]}"
